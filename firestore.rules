rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isRealUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function claimRole() {
      return isSignedIn() && 'role' in request.auth.token ? request.auth.token.role : null;
    }
    function getRole() {
      return claimRole() != null ? claimRole() : (userDocExists() ? getUserDoc().role : null);
    }
    function getEmployeeId() {
      return userDocExists() ? getUserDoc().get('employeeId', null) : null;
    }
    function getEmployeeDocId() {
      return userDocExists() ? getUserDoc().get('employeeDocId', null) : null;
    }

    // ── Role predicates ──────────────────────────────────────────────────────
    function isSuperAdmin() {
      return isSignedIn() && (
        getRole() == 'SUPER_ADMIN' ||
        claimRole() == 'superadmin' ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', '') == 'SUPER_ADMIN')
      );
    }
    function isHrAdmin() {
      return isSignedIn() && (
        getRole() == 'HR_ADMIN' ||
        isSuperAdmin() ||
        claimRole() == 'hr_admin' ||
        claimRole() == 'hr' ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', '') == 'HR_ADMIN' ||
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', '') == 'SUPER_ADMIN'))
      );
    }
    function isProjectManager() {
      return isSignedIn() && (
        getRole() == 'PROJECT_MANAGER' ||
        isSuperAdmin() ||
        claimRole() == 'project_manager' ||
        claimRole() == 'pm' ||
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('role', '') == 'PROJECT_MANAGER')
      );
    }
    function isAuthorizedTechLead() {
      return isSignedIn() && (
        request.auth.uid in ['QpDtyS6Jp5OqNu3klvfWGoWHfmS2', 'KfAB95lpbJOeylpKQaWX4GXOPGt2'] ||
        (request.auth.token.get('email', null) != null && (
          request.auth.token.email == 'satya.ranjan.dash@kalpanaaa.in' ||
          request.auth.token.email == 'satya.ranjan.das@kalpanaaa.in' ||
          request.auth.token.email == 'jasonkennethn@kalpanaaa.in'
        )) ||
        (getEmployeeId() != null && (getEmployeeId() == 'KSS2407012' || getEmployeeId() == 'KSS2407014')) ||
        (getEmployeeDocId() != null && (getEmployeeDocId() == 'emp-KSS2407012' || getEmployeeDocId() == 'KfAB95lpbJOeylpKQaWX4GXOPGt2'))
      );
    }
    function isConfigAdmin() { return isHrAdmin() || isSuperAdmin(); }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function unchanged(f) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([f]);
    }

    // ── Ownership helpers ────────────────────────────────────────────────────
    function ownsEmployeeRecord(employeeId) {
      return isRealUser() && (
        request.auth.uid == employeeId ||
        (getEmployeeDocId() != null && employeeId == getEmployeeDocId()) ||
        (getEmployeeId() != null && employeeId == getEmployeeId()) ||
        (resource != null && (
          resource.data.get('uid', '~') == request.auth.uid ||
          resource.data.get('employeeId', '~') == getEmployeeId() ||
          (request.auth.token.get('email', null) != null && resource.data.get('email', '~') == request.auth.token.email)
        ))
      );
    }
    function employeeRecord(docId) {
      return get(/databases/$(database)/documents/employees/$(docId)).data;
    }
    function ownsAttendanceData(d) {
      return isRealUser() && (
        d.get('uid', '~') == request.auth.uid ||
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('authUid', '~') == request.auth.uid ||
        (getEmployeeId() != null && (d.get('employeeCode', '~') == getEmployeeId() || d.get('employeeId', '~') == getEmployeeId())) ||
        (getEmployeeDocId() != null && (d.get('employeeId', '~') == getEmployeeDocId() || d.get('employeeDocId', '~') == getEmployeeDocId())) ||
        (
          d.get('employeeId', '') != '' &&
          exists(/databases/$(database)/documents/employees/$(d.employeeId)) &&
          (
            employeeRecord(d.employeeId).get('uid', '~') == request.auth.uid ||
            (request.auth.token.get('email', null) != null && employeeRecord(d.employeeId).get('email', '~') == request.auth.token.email)
          )
        )
      );
    }
    function ownsSalaryRecord(d) {
      return isRealUser() && (
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == getEmployeeId() ||
        d.get('employeeDocId', '~') == getEmployeeDocId()
      );
    }
    function ownsFcmToken(d) {
      return isRealUser() && d.get('uid', '~') == request.auth.uid;
    }
    function ownsLeaveRequest(d) {
      return isRealUser() && (
        d.get('employeeUid', '~') == request.auth.uid ||
        d.get('employeeId', '~') == getEmployeeId()
      );
    }
    function ownsNotification(d) {
      return isRealUser() && (
        d.get('recipientUid', '~') == request.auth.uid ||
        d.get('recipientEmployeeId', '~') == getEmployeeId() ||
        d.get('createdByUid', '~') == request.auth.uid
      );
    }
    function mirrorsEmployeeRole() {
      return isRealUser() &&
        request.resource.data.get('employeeDocId', '') != '' &&
        exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeDocId)) &&
        employeeRecord(request.resource.data.employeeDocId).get('role', '~') == request.resource.data.get('role', '~~') &&
        (
          employeeRecord(request.resource.data.employeeDocId).get('uid', '~') == request.auth.uid ||
          (request.auth.token.get('email', null) != null && employeeRecord(request.resource.data.employeeDocId).get('email', '~') == request.auth.token.email)
        );
    }

    // ── Shape validators ─────────────────────────────────────────────────────
    function validAttendanceShape() {
      let d = request.resource.data;
      return d.get('status', '') is string &&
             (!('date' in d) || (d.date is string && d.date.size() == 10));
    }
    function validLeaveShape() {
      let d = request.resource.data;
      return d.get('status', '') == 'Pending' &&
             d.keys().hasAll(['employeeId', 'type', 'startDate', 'endDate', 'reason']);
    }
    function validAuditShape() {
      return request.resource.data.keys().hasOnly([
        'id','actorId','actorName','actorRole','action','target','details','timestamp',
        'performedBy','performedByUid','targetEmployee','targetEmployeeUid',
        'role','ipAddress','userAgent','sessionId'
      ]) &&
      request.resource.data.get('action','') is string &&
      request.resource.data.get('action','').size() <= 80 &&
      request.resource.data.get('details','') is string &&
      request.resource.data.get('details','').size() <= 1000;
    }

    // ── 0. Connectivity probe (pre-auth) ─────────────────────────────────────
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── 1. Users (role-mapping) ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isHrAdmin();
      allow create, update: if isConfigAdmin() || (
        isRealUser() && isSelf(userId) && (
          request.resource.data.role == 'EMPLOYEE' ||
          mirrorsEmployeeRole() ||
          (
            exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == request.resource.data.role
          ) ||
          unchanged('role')
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ── 2. Employees Directory (PII + biometrics) ───────────────────────────
    match /employees/{employeeId} {
      allow read: if isRealUser();
      allow create: if isConfigAdmin() || (
        isRealUser() && isSelf(employeeId) && (
          request.resource.data.role == 'EMPLOYEE' ||
          (userDocExists() && getUserDoc().role == request.resource.data.role)
        )
      );
      allow update: if isConfigAdmin() || (
        ownsEmployeeRecord(employeeId) &&
        unchanged('role') && unchanged('executiveRole') && unchanged('employeeId') &&
        unchanged('email') && unchanged('salary') && unchanged('ctc') &&
        unchanged('joiningDate') && unchanged('probationEndDate') &&
        unchanged('bankAccountNumber') && unchanged('bankIfscCode') && unchanged('panNumber') &&
        unchanged('approvedWfhDates') && unchanged('designation') && unchanged('department') &&
        unchanged('status') && unchanged('shift') && unchanged('pmUid') &&
        unchanged('reportingManagerUid') && unchanged('qrToken') &&
        unchanged('accessLevel') && unchanged('permissions')
      );
      allow delete: if isSuperAdmin();

      // 2a. Leave date-locks
      match /leaveLocks/{lockDate} {
        allow read: if isRealUser();
        allow create, update: if isRealUser() && (
          isProjectManager() || isConfigAdmin() ||
          employeeId == getEmployeeId() ||
          request.resource.data.get('employeeUid','~') == request.auth.uid
        );
        allow delete: if isRealUser() && (
          isProjectManager() || isConfigAdmin() ||
          employeeId == getEmployeeId() ||
          (resource != null && resource.data.get('employeeUid','~') == request.auth.uid)
        );
      }

      // 2b. Private resume subcollection
      match /private/{docId} {
        allow read: if isConfigAdmin() ||
          (isRealUser() && (employeeId == request.auth.uid || employeeId == getEmployeeDocId()));
        allow write: if isConfigAdmin();
      }
    }

    // ── 3. Attendance Records ────────────────────────────────────────────────
    match /attendance/{recordId} {
      allow read: if isRealUser();
      allow create: if isRealUser() && (
        isHrAdmin() || isSuperAdmin() || isProjectManager() ||
        ((recordId.split('_')[0] == request.auth.uid || ownsAttendanceData(request.resource.data)) && validAttendanceShape())
      );
      allow update: if isRealUser() && (
        isHrAdmin() || isSuperAdmin() || isProjectManager() ||
        recordId.split('_')[0] == request.auth.uid ||
        ownsAttendanceData(resource.data) ||
        ownsAttendanceData(request.resource.data)
      );
      allow delete: if isSuperAdmin();
    }

    // ── 4. Leave & WFH Requests ──────────────────────────────────────────────
    match /leaveRequests/{requestId} {
      allow read: if isRealUser();
      allow create: if isRealUser() && validLeaveShape();
      allow update: if isRealUser() && (
        isHrAdmin() || isSuperAdmin() || isProjectManager() ||
        (
          ownsLeaveRequest(resource.data) && (
            request.resource.data.get('status','') == 'Pending' ||
            request.resource.data.get('status','') == 'Cancelled' ||
            (unchanged('status') && unchanged('pmStatus') && unchanged('hrStatus') && unchanged('ceoStatus') && unchanged('ctoStatus'))
          )
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ── 5. Salary Disbursements (payroll — max sensitivity) ──────────────────
    match /salaryDisbursements/{recordId} {
      allow read: if isRealUser() && (isHrAdmin() || isSuperAdmin() || ownsSalaryRecord(resource.data));
      allow create, update: if isHrAdmin() || isSuperAdmin();
      allow delete: if false;
    }

    // ── 6. Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isRealUser();
      allow create: if isRealUser() && (
        !('ALL' in request.resource.data.get('audience',[])) ||
        isProjectManager() || isConfigAdmin()
      );
      allow update: if isRealUser() && (isConfigAdmin() || isProjectManager() || ownsNotification(resource.data));
      allow delete: if isRealUser() && (isHrAdmin() || isSuperAdmin() || ownsNotification(resource.data));
    }

    // ── 7. FCM Push Tokens ───────────────────────────────────────────────────
    match /fcmTokens/{tokenId} {
      allow read: if isConfigAdmin();
      allow create, update: if isRealUser();
      allow delete: if isRealUser() && (isConfigAdmin() || ownsFcmToken(resource.data));
    }

    // ── 8. Settings ──────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isRealUser();
      allow create, update: if isConfigAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── 9. Company Config (WFH dates — CEO/CTO only to write) ───────────────
    match /companyConfig/{configId} {
      allow read: if isRealUser();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── 10. Company Rules (HR handbook) ──────────────────────────────────────
    match /companyRules/{ruleId} {
      allow read: if isRealUser();
      allow create, update, delete: if isConfigAdmin();
    }

    // ── 11. Work Zones (geo-fence) ───────────────────────────────────────────
    match /workZones/{zoneId} {
      allow read: if isRealUser();
      allow create, update: if isConfigAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── 12. Projects ─────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isRealUser();
      allow create, update, delete: if isProjectManager() || isConfigAdmin();
    }

    // ── 13. Kanban Tasks ─────────────────────────────────────────────────────
    match /projectTasks/{taskId} {
      allow read, create, update: if isRealUser();
      allow delete: if isProjectManager() || isConfigAdmin();
    }

    // ── 14. 1:1 Manager Notes (PM-private) ───────────────────────────────────
    match /oneOnOneNotes/{noteId} {
      allow read: if isProjectManager() || isConfigAdmin() ||
        (isRealUser() && resource != null && (
          resource.data.get('employeeId','~') == getEmployeeId() ||
          resource.data.get('employeeId','~') == getEmployeeDocId() ||
          resource.data.get('employeeUid','~') == request.auth.uid
        ));
      allow create, update: if isProjectManager() || isConfigAdmin();
      allow delete: if isConfigAdmin();
    }

    // ── 15. Audit Logs (append-only) ─────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isConfigAdmin();
      allow create: if isRealUser() && validAuditShape();
      allow update, delete: if false;
    }

    // ── 16. Error Diagnostics ────────────────────────────────────────────────
    match /error_logs/{logId} {
      allow read: if isConfigAdmin();
      allow create: if
        request.resource.data.keys().hasOnly([
          'timestamp','timestampMs','category','message','stack',
          'uid','employeeId','role','deviceCategory','browser','os',
          'network','route','appVersion','buildVersion','userAgent',
          'operationType','path'
        ]) &&
        request.resource.data.get('message', '') is string &&
        request.resource.data.get('message', '').size() <= 500;
      allow update, delete: if false;
    }

    // ── 17. Performance Appraisals ───────────────────────────────────────────
    match /performanceFeedbacks/{feedbackId} {
      function isSubject() {
        return isRealUser() && (
          resource.data.targetEmployeeId == request.auth.uid ||
          resource.data.targetEmployeeId == getEmployeeDocId() ||
          resource.data.targetEmployeeCode == getEmployeeId()
        );
      }
      function isAcknowledgementOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['isAcknowledged', 'acknowledgedAt', 'updatedAt']) &&
               request.resource.data.isAcknowledged == true;
      }
      function isAuthor() {
        return isRealUser() && (
          resource.data.reviewerId == request.auth.uid ||
          resource.data.reviewerId == getEmployeeDocId()
        );
      }
      function callerTier() {
        return isSuperAdmin() ? 5 : (isHrAdmin() ? 3 : (isProjectManager() ? 2 : 1));
      }
      allow read: if isConfigAdmin() || isSubject() || isAuthor() || isAuthorizedTechLead() ||
        (isProjectManager() && resource.data.subjectTier == 1);
      allow create: if (isConfigAdmin() || isProjectManager() || isAuthorizedTechLead()) &&
        request.resource.data.reviewerId is string &&
        (request.resource.data.reviewerId == request.auth.uid || request.resource.data.reviewerId == getEmployeeDocId()) &&
        request.resource.data.targetEmployeeId is string &&
        request.resource.data.targetEmployeeId.size() > 0 &&
        request.resource.data.targetEmployeeId != request.resource.data.reviewerId &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.isAcknowledged == false &&
        request.resource.data.subjectTier is number &&
        request.resource.data.subjectTier >= 1 &&
        (isAuthorizedTechLead() || request.resource.data.subjectTier < callerTier());
      allow update: if
        (isConfigAdmin() && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier')) ||
        ((isProjectManager() || isAuthorizedTechLead()) && isAuthor() && unchanged('reviewerId') && unchanged('targetEmployeeId') && unchanged('subjectTier')) ||
        (isSubject() && isAcknowledgementOnly());
      allow delete: if isConfigAdmin() ||
        (isAuthor() && resource.data.get('isAcknowledged', false) == false);

      match /confidential/{noteId} {
        allow read, write: if isConfigAdmin();
      }
    }

    // ── 18. Feedback Quizzes ─────────────────────────────────────────────────
    match /feedbackQuizzes/{quizId} {
      allow read: if isRealUser();
      allow create, delete: if isRealUser() && (isSuperAdmin() || isHrAdmin() || isProjectManager());
      allow update: if isRealUser() && (
        isSuperAdmin() || isHrAdmin() || isProjectManager() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responseCount','updatedAt'])
      );

      match /responses/{responseId} {
        allow read: if isRealUser() && (
          isSuperAdmin() || isHrAdmin() || isProjectManager() ||
          (resource != null && (
            resource.data.get('employeeId','~') == getEmployeeDocId() ||
            resource.data.get('employeeId','~') == request.auth.uid ||
            resource.data.get('employeeId','~') == getEmployeeId()
          ))
        );
        allow create: if isRealUser() && (
          request.resource.data.get('employeeId','~') == getEmployeeDocId() ||
          request.resource.data.get('employeeId','~') == request.auth.uid ||
          request.resource.data.get('employeeId','~') == getEmployeeId()
        );
        allow update, delete: if false;
      }
    }

  }
}
