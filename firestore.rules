rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true; // Temporarily allow public read
      allow create, update: if isSignedIn() && isValidId(userId);
      allow delete: if isSignedIn();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if true; 
      allow create, update: if isValidId(employeeId);
      allow delete: if true;
    }

    // Attendance records collection
    match /attendance/{recordId} {
      allow read: if true; 
      allow create, update: if isValidId(recordId);
      allow delete: if true;
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read: if true; 
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // Leave requests collection
    match /leaveRequests/{requestId} {
      allow read, create, update, delete: if true;
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read, create, update, delete: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true; 
      allow create, update: if true;
      allow delete: if false;
    }

    // WorkZones collection
    match /workZones/{zoneId} {
      allow read: if true; 
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
