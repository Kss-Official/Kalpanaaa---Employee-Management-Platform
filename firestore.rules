rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global RBAC Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserDoc().role;
    }

    function getEmployeeId() {
      return getUserDoc().employeeId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getUserDoc().role == 'SUPER_ADMIN' || 
        (request.auth.token.role != null && (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'superadmin'))
      );
    }

    function isCeo() {
      return isSignedIn() && (getRole() == 'CEO' || (isSuperAdmin() && getUserDoc().executiveRole == 'CEO'));
    }

    function isCto() {
      return isSignedIn() && (getRole() == 'CTO' || (isSuperAdmin() && getUserDoc().executiveRole == 'CTO'));
    }

    function isHrAdmin() {
      return isSignedIn() && (
        getUserDoc().role == 'HR_ADMIN' || 
        isSuperAdmin() || 
        (request.auth.token.role != null && (request.auth.token.role == 'HR_ADMIN' || request.auth.token.role == 'hr_admin' || request.auth.token.role == 'hr' || request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'superadmin'))
      );
    }

    function isProjectManager() {
      return isSignedIn() && (
        getUserDoc().role == 'PROJECT_MANAGER' || 
        isSuperAdmin() ||
        (request.auth.token.role != null && (request.auth.token.role == 'PROJECT_MANAGER' || request.auth.token.role == 'project_manager' || request.auth.token.role == 'pm'))
      );
    }

    function isAttendanceOwner(recordId) {
      return recordId.matches('^' + request.auth.uid + '_.*') ||
        (resource != null && (resource.data.uid == request.auth.uid || resource.data.employeeUid == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.uid == request.auth.uid || request.resource.data.employeeUid == request.auth.uid));
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // ── 1. Users Collection ──
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isHrAdmin() || isSuperAdmin()
      );
      // Self-creation locks role strictly to 'EMPLOYEE'. Only SuperAdmin can provision privileged roles.
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'EMPLOYEE') ||
        isSuperAdmin()
      );
      // Self-update cannot modify role, uid, or employeeId
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'executiveRole', 'uid', 'employeeId'])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ── 2. Employees Directory ──
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isHrAdmin() || isSuperAdmin();
      allow update: if isHrAdmin() || isSuperAdmin() || isSignedIn();
      allow delete: if isSuperAdmin();

      // Date lock subcollection for overlapping leave prevention
      match /leaveLocks/{lockDate} {
        allow read: if isSignedIn();
        allow write, delete: if isSignedIn();
      }
    }

    // ── 3. Attendance Records (Atomic Owner-Scoped & Field Restricted) ──
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      
      // (a) Forbid creating duplicate doc; employee can create only their own doc
      allow create: if isSignedIn() && (
        isSuperAdmin() || isHrAdmin() || (
          isAttendanceOwner(recordId) && !exists(/databases/$(database)/documents/attendance/$(recordId))
        )
      );
      
      // (b) & (c) Forbid modifying checkInAt or overwriting existing checkOutAt
      // Employees are restricted to updating ONLY checkout, break, and duration fields
      allow update: if isSignedIn() && (
        isSuperAdmin() || isHrAdmin() || (
          isAttendanceOwner(recordId) &&
          // Immutable checkInAt once recorded
          (!('checkInAt' in resource.data) || resource.data.checkInAt == null || request.resource.data.checkInAt == resource.data.checkInAt) &&
          // Immutable checkOutAt once recorded (cannot re-checkout or overwrite)
          (!('checkOutAt' in resource.data) || resource.data.checkOutAt == null || request.resource.data.checkOutAt == resource.data.checkOutAt) &&
          // Field-level modification restriction for regular employees
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'checkOutAt', 'updatedAt', 'breaks', 'totalBreakMinutes', 'workingMinutes',
            'notes', 'locationAccuracy', 'distanceFromOffice', 'locationVerified', 'isWfh', 'status'
          ])
        )
      );
      
      allow delete: if isSuperAdmin();
    }

    // ── 4. Leave & WFH Requests Collection ──
    match /leaveRequests/{requestId} {
      
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.startDate is string &&
        request.resource.data.endDate is string &&
        request.resource.data.type in ['Leave', 'WFH'];

      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── 5. Notifications Collection ──
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isHrAdmin() || isSuperAdmin();
    }

    // ── 6. FCM Tokens Collection ──
    match /fcmTokens/{tokenId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── 7. Settings & Configuration ──
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow update, create: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /companyConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── 8. Workplace Rules ──
    match /companyRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── 9. PM Projects & Kanban Tasks ──
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    match /projectTasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    match /oneOnOneNotes/{noteId} {
      allow read, write: if isSignedIn();
    }

    // ── 10. Audit Logs (Immutable Append-Only) ──
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Append-only audit trail
    }
  }
}
