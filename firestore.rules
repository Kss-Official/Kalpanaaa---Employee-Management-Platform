rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global RBAC Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserDoc().role;
    }

    function getEmployeeId() {
      return getUserDoc().employeeId;
    }

    function isSuperAdmin() {
      return isSignedIn() && getRole() == 'SUPER_ADMIN';
    }

    function isCeo() {
      return isSignedIn() && (getRole() == 'CEO' || (isSuperAdmin() && getUserDoc().executiveRole == 'CEO'));
    }

    function isCto() {
      return isSignedIn() && (getRole() == 'CTO' || (isSuperAdmin() && getUserDoc().executiveRole == 'CTO'));
    }

    function isHrAdmin() {
      return isSignedIn() && (getRole() == 'HR_ADMIN' || isSuperAdmin());
    }

    function isProjectManager() {
      return isSignedIn() && (getRole() == 'PROJECT_MANAGER' || isSuperAdmin());
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // ── 1. Users Collection ──
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || isHrAdmin() || isSuperAdmin()
      );
      // Self-creation locks role strictly to 'EMPLOYEE'. Only SuperAdmin can provision privileged roles.
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == 'EMPLOYEE') ||
        isSuperAdmin()
      );
      // Self-update cannot modify role, uid, or employeeId
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'executiveRole', 'uid', 'employeeId'])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ── 2. Employees Directory ──
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isHrAdmin() || isSuperAdmin();
      allow update: if isHrAdmin() || isSuperAdmin() || (
        isSignedIn() && request.auth.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio', 'skills', 'currentAddress', 'phone', 'preferredShift', 'linkedinUrl', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();

      // Date lock subcollection for overlapping leave prevention
      match /leaveLocks/{lockDate} {
        allow read: if isSignedIn();
        allow write, delete: if isSignedIn();
      }
    }

    // ── 3. Attendance Records ──
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── 4. Leave & WFH Requests Collection ──
    match /leaveRequests/{requestId} {
      
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.startDate is string &&
        request.resource.data.endDate is string &&
        request.resource.data.type in ['Leave', 'WFH'];

      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // ── 5. Notifications Collection ──
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isHrAdmin() || isSuperAdmin();
    }

    // ── 6. FCM Tokens Collection ──
    match /fcmTokens/{tokenId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── 7. Settings & Configuration ──
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow update, create: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /companyConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── 8. Workplace Rules ──
    match /companyRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── 9. PM Projects & Kanban Tasks ──
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    match /projectTasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    match /oneOnOneNotes/{noteId} {
      allow read, write: if isSignedIn();
    }

    // ── 10. Audit Logs (Immutable Append-Only) ──
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Append-only audit trail
    }
  }
}
