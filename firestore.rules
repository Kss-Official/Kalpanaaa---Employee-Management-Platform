rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global RBAC Helpers ──
    function isSignedIn() {
      return request.auth != null;
    }

    // P0 FIX: get() THROWS when the document does not exist, which denied every
    // rule that touched getUserDoc() for accounts lacking a users/{uid} doc.
    // exists() never throws — role simply resolves to null (still unauthorized),
    // so authorization outcomes are unchanged for well-formed data while the
    // crash-deny path is removed.
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return userDocExists() ? getUserDoc().role : null;
    }

    function getEmployeeId() {
      return userDocExists() ? getUserDoc().employeeId : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getRole() == 'SUPER_ADMIN' || 
        (request.auth.token.role != null && (request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'superadmin'))
      );
    }

    function isHrAdmin() {
      return isSignedIn() && (
        getRole() == 'HR_ADMIN' || 
        isSuperAdmin() || 
        (request.auth.token.role != null && (request.auth.token.role == 'HR_ADMIN' || request.auth.token.role == 'hr_admin' || request.auth.token.role == 'hr' || request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.role == 'superadmin'))
      );
    }

    function isProjectManager() {
      return isSignedIn() && (
        getRole() == 'PROJECT_MANAGER' || 
        isSuperAdmin() ||
        (request.auth.token.role != null && (request.auth.token.role == 'PROJECT_MANAGER' || request.auth.token.role == 'project_manager' || request.auth.token.role == 'pm'))
      );
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Test collection used for the connectivity probe
    match /test/{docId} {
      allow read: if true;
    }

    // ── 1. Users Collection ──
    match /users/{userId} {
      allow read, write, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ── 2. Employees Directory ──
    match /employees/{employeeId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();

      // Date lock subcollection for overlapping leave prevention
      match /leaveLocks/{lockDate} {
        allow read, write, delete: if true;
      }
    }

    // ── 3. Attendance Records (Live Workforce & Single Source of Truth) ──
    match /attendance/{recordId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ── 4. Leave & WFH Requests Collection ──
    match /leaveRequests/{requestId} {
      allow read, write: if true;
      allow delete: if isSuperAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ── 5. Salary Disbursements (persisted payroll runs) ──
    match /salaryDisbursements/{recordId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── 6. Notifications Collection ──
    match /notifications/{notifId} {
      allow read, write: if true;
      allow delete: if isHrAdmin() || isSuperAdmin();
    }

    // ── 7. FCM Tokens Collection ──
    match /fcmTokens/{tokenId} {
      allow read, write: if true;
    }

    // ── 8. Settings & Configuration ──
    match /settings/{settingId} {
      allow read, write: if true;
      allow delete: if isSuperAdmin();
    }

    match /companyConfig/{configId} {
      allow read, write: if true;
    }

    // ── 9. Workplace Rules ──
    match /companyRules/{ruleId} {
      allow read, write: if true;
    }

    // ── 10. Work Zones (geo-fence definitions) ──
    match /workZones/{zoneId} {
      allow read, write: if true;
      allow delete: if isSuperAdmin();
    }

    // ── 11. PM Projects & Kanban Tasks ──
    match /projects/{projectId} {
      allow read, write: if true;
    }

    match /projectTasks/{taskId} {
      allow read, write: if true;
    }

    match /oneOnOneNotes/{noteId} {
      allow read, write: if true;
    }

    // ── 12. Audit Logs (Immutable Append-Only) ──
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false; // Append-only audit trail
    }

    // ── 13. Error Diagnostics (Phase 22 observability) ──
    // CREATE stays open: failures can occur before authentication and must
    // still be recorded. READ requires sign-in. Records are immutable.
    match /error_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
